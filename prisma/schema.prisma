generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MECHANIC
  ADMIN
}

enum SOSStatus {
  REQUESTED
  ASSIGNED
  ON_PROGRESS
  DONE
  CANCELED
}

enum AssigmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  vehicles           Vehicle[]
  requests           SOSRequest[]
  mechanicAssigments Assigment[]  @relation("MechanicAssigments")

  latitude    Float?
  longitude   Float?
  isAvailable Boolean? @default(false)

  notifications Notification[]
}

model Vehicle {
  id          String @id @default(uuid())
  userId      String
  brand       String
  model       String
  plateNumber String @unique

  user     User         @relation(fields: [userId], references: [id])
  requests SOSRequest[]

  createdAt DateTime @default(now())
}

model SOSRequest {
  id        String    @id @default(uuid())
  userId    String
  vehicleId String
  latitude  Float
  longitude Float
  status    SOSStatus @default(REQUESTED)
  createdAt DateTime  @default(now())

  user      User         @relation(fields: [userId], references: [id])
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])
  assigment Assigment?
  logs      ServiceLog[]
}

model Assigment {
  id           String          @id @default(uuid())
  sosRequestId String          @unique
  mechanicId   String
  status       AssigmentStatus @default(PENDING)
  assignedAt   DateTime        @default(now())

  sosRequest SOSRequest @relation(fields: [sosRequestId], references: [id])
  mechanic   User       @relation("MechanicAssigments", fields: [mechanicId], references: [id])
}

model ServiceLog {
  id           String          @id @default(uuid())
  sosRequestId String
  mechanicId   String
  status       AssigmentStatus @default(PENDING)
  assignedAt   DateTime        @default(now())

  sosRequest SOSRequest @relation(fields: [sosRequestId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
