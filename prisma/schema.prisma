generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                  String         @id @default(uuid())
  name                String
  phone               String         @unique
  role                Role           @default(CUSTOMER)
  created_at          DateTime       @default(now())
  /// For mechanics
  latitude            Float?
  longitude           Float?
  is_available        Boolean?       @default(false)
  mechanic_assigments assigment[]    @relation("MechanicAssigments")
  notifications       notification[]
  requests            sos_request[]
  vehicles            vehicle[]
}

model vehicle {
  id           String        @id @default(uuid())
  user_id      String
  brand        String
  model        String
  plate_number String        @unique
  created_at   DateTime      @default(now())
  requests     sos_request[]
  user         user          @relation(fields: [user_id], references: [id])
}

model sos_request {
  id         String        @id @default(uuid())
  user_id    String
  vehicle_id String
  latitude   Float
  longitude  Float
  status     SOSStatus     @default(REQUESTED)
  created_at DateTime      @default(now())
  assigment  assigment?
  logs       service_log[]
  user       user          @relation(fields: [user_id], references: [id])
  vehicle    vehicle       @relation(fields: [vehicle_id], references: [id])
}

model assigment {
  id             String           @id @default(uuid())
  sos_request_id String           @unique
  mechanic_id    String
  status         AssignmentStatus @default(PENDING)
  assigned_at    DateTime         @default(now())
  mechanic       user             @relation("MechanicAssigments", fields: [mechanic_id], references: [id])
  sos_request    sos_request      @relation(fields: [sos_request_id], references: [id])
}

model service_log {
  id             String           @id @default(uuid())
  sos_request_id String
  mechanic_id    String
  status         AssignmentStatus @default(PENDING)
  assigned_at    DateTime         @default(now())
  sos_request    sos_request      @relation(fields: [sos_request_id], references: [id])
}

model notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  user       user     @relation(fields: [user_id], references: [id])
}

enum Role {
  CUSTOMER
  MECHANIC
  ADMIN
}

enum SOSStatus {
  REQUESTED
  ASSIGNED
  ON_PROGRESS
  DONE
  CANCELED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}
